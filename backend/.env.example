# HowToFitness Backend Environment Configuration
# Copy this file to .env and fill in your actual values.

# Database URL (default: SQLite)
# DATABASE_URL=sqlite+aiosqlite:///./htf.db

# JWT Secret Key – change this in production!
# JWT_SECRET_KEY=change-me-in-production-use-a-strong-random-key

# DeepSeek AI API Key (REQUIRED for AI features)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# DeepSeek Base URL (default: https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# CORS Origins (comma separated, default: *)
# CORS_ORIGINS=["*"]
